# AIM Network (Autonomous M2M API Hub) - Environment Template
# Copy this file to .env and set your secret ADMIN_PIN before running.
WALLET_ADDRESS=0x_YOUR_BASE_USDC_WALLET_ADDRESS
ADMIN_PIN=CHANGE_ME_TO_A_STRONG_SECRET_TOKEN
SCOUT_SECRET_TOKEN=CHANGE_ME_TO_A_STRONG_SECRET_TOKEN
X402_VERIFY_MODE=strict_onchain
TESTING=false
TRUST_PROXY_HEADERS=false
BASE_RPC_URL=https://mainnet.base.org
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
DATABASE_PATH=data/aim_network.db
